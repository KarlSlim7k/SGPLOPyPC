# Variables de entorno para SGPLOPyPC
# Copiar a .env y ajustar valores reales (nunca commitear .env)

# Base de datos (sin defaults inseguros; deben configurarse explícitamente)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sgplopypc
DB_USER=
DB_PASS=

# Seguridad (generar secretos fuertes en producción)
JWT_SECRET=
JWT_TTL=86400

# Entorno: development | production
APP_ENV=production

# Rate limiting (ventana en segundos)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_UPLOAD_WINDOW=60
RATE_LIMIT_EXPORT_MAX=5
RATE_LIMIT_EXPORT_WINDOW=60
RATE_LIMIT_FORGOT_MAX=5
RATE_LIMIT_FORGOT_WINDOW=300
RATE_LIMIT_RESET_MAX=10
RATE_LIMIT_RESET_WINDOW=300
RATE_LIMIT_PUBLIC_REGISTER_MAX=5
RATE_LIMIT_PUBLIC_REGISTER_WINDOW=300
RATE_LIMIT_PUBLIC_SUPPORT_MAX=5
RATE_LIMIT_PUBLIC_SUPPORT_WINDOW=300

# Recuperación de contraseña
PASSWORD_RESET_TTL_SECONDS=3600
APP_BASE_URL=

# Correo saliente opcional
MAIL_ENABLED=0
MAIL_FROM=no-reply@sgplopypc.gob.mx
SUPPORT_EMAIL_TO=

# Retención de backups (días)
BACKUP_RETENTION_DAYS=14
